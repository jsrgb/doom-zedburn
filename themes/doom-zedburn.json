{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Doom Zedburn",
  "author": "Ja Morphy; based on zenburn-emacs by Bozhidar Batsov and contributors",
  "themes": [
    {
      "name": "Doom Zedburn",
      "appearance": "dark",
      "style": {
        "background": "#3F3F3F",
        "background.appearance": "opaque",
        "surface.background": "#383838",
        "elevated_surface.background": "#494949",
        "panel.background": "#383838",
        "panel.focused_border": "#D0BF8F",
        "panel.indent_guide": "#4F4F4F",
        "panel.indent_guide_active": "#6F6F6F",
        "panel.indent_guide_hover": "#5F5F5F",

        "title_bar.background": "#2B2B2B",
        "title_bar.inactive_background": "#303030",
        "toolbar.background": "#383838",
        "status_bar.background": "#2B2B2B",
        "tab_bar.background": "#2B2B2B",
        "tab.active_background": "#3F3F3F",
        "tab.inactive_background": "#303030",

        "border": "#4F4F4F",
        "border.variant": "#494949",
        "border.focused": "#D0BF8F",
        "border.selected": "#D0BF8F",
        "border.transparent": "#3F3F3F00",
        "border.disabled": "#494949",
        "pane.focused_border": "#D0BF8F",
        "pane_group.border": "#4F4F4F",

        "element.background": "#3F3F3F",
        "element.hover": "#494949",
        "element.active": "#4F4F4F",
        "element.selected": "#2B2B2B",
        "element.disabled": "#383838",
        "ghost_element.background": "#3F3F3F00",
        "ghost_element.hover": "#494949",
        "ghost_element.active": "#4F4F4F",
        "ghost_element.selected": "#2B2B2B",
        "ghost_element.disabled": "#38383880",
        "drop_target.background": "#5F5F5F80",

        "text": "#DCDCCC",
        "text.muted": "#989890",
        "text.placeholder": "#656555",
        "text.disabled": "#656555",
        "text.accent": "#F0DFAF",
        "icon": "#DCDCCC",
        "icon.muted": "#989890",
        "icon.placeholder": "#656555",
        "icon.disabled": "#656555",
        "icon.accent": "#F0DFAF",
        "link_text.hover": "#E0CF9F",

        "error": "#CC9393",
        "error.background": "#553333",
        "error.border": "#AC7373",
        "warning": "#DFAF8F",
        "warning.background": "#555511",
        "warning.border": "#D0BF8F",
        "success": "#7F9F7F",
        "success.background": "#335533",
        "success.border": "#6F8F6F",
        "info": "#8CD0D3",
        "info.background": "#366060",
        "info.border": "#6CA0A3",
        "hint": "#989890",
        "hint.background": "#383838",
        "hint.border": "#5F5F5F",

        "created": "#7F9F7F",
        "created.background": "#335533",
        "created.border": "#6F8F6F",
        "modified": "#E0CF9F",
        "modified.background": "#555511",
        "modified.border": "#D0BF8F",
        "deleted": "#AC7373",
        "deleted.background": "#553333",
        "deleted.border": "#9C6363",
        "renamed": "#8CD0D3",
        "renamed.background": "#366060",
        "renamed.border": "#6CA0A3",
        "conflict": "#DFAF8F",
        "conflict.background": "#553333",
        "conflict.border": "#DFAF8F",
        "ignored": "#656555",
        "ignored.background": "#383838",
        "ignored.border": "#494949",
        "hidden": "#656555",
        "hidden.background": "#383838",
        "hidden.border": "#494949",
        "unreachable": "#AC7373",
        "unreachable.background": "#383838",
        "unreachable.border": "#553333",
        "predictive": "#656555",
        "predictive.background": "#383838",
        "predictive.border": "#494949",

        "editor.background": "#3F3F3F",
        "editor.foreground": "#DCDCCC",
        "editor.gutter.background": "#383838",
        "editor.subheader.background": "#2B2B2B",
        "editor.active_line.background": "#383838",
        "editor.highlighted_line.background": "#494949",
        "editor.line_number": "#6F6F6F",
        "editor.active_line_number": "#D0BF8F",
        "editor.invisible": "#5F5F5F",
        "editor.wrap_guide": "#494949",
        "editor.active_wrap_guide": "#6F6F6F",
        "editor.indent_guide": "#494949",
        "editor.indent_guide_active": "#6F6F6F",
        "editor.document_highlight.read_background": "#4F4F4F",
        "editor.document_highlight.write_background": "#5F5F5F",
        "editor.document_highlight.bracket_background": "#6F6F6F",
        "search.match_background": "#2B2B2B",

        "scrollbar.track.background": "#2B2B2B80",
        "scrollbar.track.border": "#49494980",
        "scrollbar.thumb.background": "#6F6F6F80",
        "scrollbar.thumb.hover_background": "#98989080",
        "scrollbar.thumb.border": "#3F3F3F80",

        "terminal.background": "#3F3F3F",
        "terminal.foreground": "#DCDCCC",
        "terminal.bright_foreground": "#FFFFEF",
        "terminal.dim_foreground": "#989890",
        "terminal.ansi.background": "#3F3F3F",
        "terminal.ansi.black": "#3F3F3F",
        "terminal.ansi.red": "#AC7373",
        "terminal.ansi.green": "#7F9F7F",
        "terminal.ansi.yellow": "#DFAF8F",
        "terminal.ansi.blue": "#7CB8BB",
        "terminal.ansi.magenta": "#DC8CC3",
        "terminal.ansi.cyan": "#93E0E3",
        "terminal.ansi.white": "#DCDCCC",
        "terminal.ansi.bright_black": "#6F6F6F",
        "terminal.ansi.bright_red": "#DCA3A3",
        "terminal.ansi.bright_green": "#BFEBBF",
        "terminal.ansi.bright_yellow": "#F0DFAF",
        "terminal.ansi.bright_blue": "#BDE0F3",
        "terminal.ansi.bright_magenta": "#ECB3B3",
        "terminal.ansi.bright_cyan": "#ACE0E3",
        "terminal.ansi.bright_white": "#FFFFEF",
        "terminal.ansi.dim_black": "#2B2B2B",
        "terminal.ansi.dim_red": "#8C5353",
        "terminal.ansi.dim_green": "#5F7F5F",
        "terminal.ansi.dim_yellow": "#D0BF8F",
        "terminal.ansi.dim_blue": "#5C888B",
        "terminal.ansi.dim_magenta": "#BC8383",
        "terminal.ansi.dim_cyan": "#6CA0A3",
        "terminal.ansi.dim_white": "#989890",

        "accents": [
          "#F0DFAF",
          "#8CD0D3",
          "#7F9F7F",
          "#CC9393",
          "#DFAF8F",
          "#DC8CC3",
          "#94BFF3"
        ],
        "players": [
          { "cursor": "#F0DFAF", "background": "#F0DFAF30", "selection": "#F0DFAF30" },
          { "cursor": "#93E0E3", "background": "#93E0E330", "selection": "#93E0E330" },
          { "cursor": "#BFEBBF", "background": "#BFEBBF30", "selection": "#BFEBBF30" },
          { "cursor": "#DCA3A3", "background": "#DCA3A330", "selection": "#DCA3A330" },
          { "cursor": "#DC8CC3", "background": "#DC8CC330", "selection": "#DC8CC330" }
        ],

        "syntax": {
          "attribute": { "color": "#DFAF8F" },
          "boolean": { "color": "#BFEBBF" },
          "comment": { "color": "#7F9F7F" },
          "comment.doc": { "color": "#9FC59F" },
          "constant": { "color": "#BFEBBF" },
          "constant.builtin": { "color": "#BFEBBF", "font_weight": 700 },
          "constructor": { "color": "#7CB8BB" },
          "embedded": { "color": "#DCDCCC" },
          "emphasis": { "color": "#DCDCCC", "font_style": "italic" },
          "emphasis.strong": { "color": "#FFFFEF", "font_weight": 700 },
          "enum": { "color": "#7CB8BB" },
          "function": { "color": "#93E0E3" },
          "hint": { "color": "#989890", "font_style": "italic" },
          "keyword": { "color": "#F0DFAF", "font_weight": 700 },
          "label": { "color": "#E0CF9F" },
          "link_text": { "color": "#F0DFAF", "font_weight": 700 },
          "link_uri": { "color": "#D0BF8F" },
          "number": { "color": "#BFEBBF" },
          "operator": { "color": "#DCDCCC" },
          "predictive": { "color": "#656555", "font_style": "italic" },
          "preproc": { "color": "#94BFF3" },
          "primary": { "color": "#FFFFEF" },
          "property": { "color": "#DFAF8F" },
          "punctuation": { "color": "#DCDCCC" },
          "punctuation.bracket": { "color": "#DCDCCC" },
          "punctuation.delimiter": { "color": "#DCDCCC" },
          "punctuation.list_marker": { "color": "#F0DFAF", "font_weight": 700 },
          "punctuation.special": { "color": "#F0DFAF", "font_weight": 700 },
          "string": { "color": "#CC9393" },
          "string.escape": { "color": "#7F9F7F", "font_weight": 700 },
          "string.regex": { "color": "#CC9393" },
          "string.special": { "color": "#DCA3A3" },
          "string.special.symbol": { "color": "#BFEBBF" },
          "tag": { "color": "#93E0E3" },
          "tag.doctype": { "color": "#7F9F7F" },
          "text.literal": { "color": "#BFEBBF" },
          "title": { "color": "#8CD0D3", "font_weight": 700 },
          "type": { "color": "#7CB8BB" },
          "type.builtin": { "color": "#7CB8BB", "font_weight": 700 },
          "variable": { "color": "#DFAF8F" },
          "variable.parameter": { "color": "#DFAF8F" },
          "variable.special": { "color": "#F0DFAF", "font_weight": 700 },
          "variant": { "color": "#BFEBBF" }
        }
      }
    }
  ]
}
